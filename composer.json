{
    "name":        "iyogesharma/log-viewer",
    "description": "Log Viewer for Laravel with a bounded-memory streaming index engine for large log files. Fork of arcanedev/log-viewer.",
    "keywords":    ["laravel", "log", "log viewer", "log-viewer", "logviewer", "streaming", "large files", "arcanedev"],
    "homepage":    "https://github.com/iYogesharma/logviewer-laravel",
    "authors": [
        {
            "name":     "Yogesh Sharma",
            "email":    "iyogesharma@gmail.com",
            "homepage": "https://github.com/iYogesharma",
            "role":     "Fork maintainer"
        },
        {
            "name":     "ARCANEDEV",
            "email":    "arcanedev.maroc@gmail.com",
            "homepage": "https://github.com/arcanedev-maroc",
            "role":     "Original developer"
        }
    ],
    "support": {
        "issues": "https://github.com/iYogesharma/logviewer-laravel/issues",
        "source": "https://github.com/iYogesharma/logviewer-laravel"
    },
    "type":    "library",
    "license": "MIT",
    "require": { 
        "php": ">=7.3",
        "ext-json": "*",
        "arcanedev/support": ">=8.0",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "laravel/framework": ">=8.0",
        "mockery/mockery": ">=1.4.2",
        "orchestra/testbench-core": ">=6.27",
        "phpunit/phpunit": ">=9.5.10"
    },
    "autoload": {
        "psr-4": {
            "Arcanedev\\LogViewer\\": "src/"
        },
        "files": ["helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Arcanedev\\LogViewer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test:dox": "phpunit --testdox --colors=always",
        "test:cov": "phpunit --coverage-html build/coverage"
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "Arcanedev\\LogViewer\\LogViewerServiceProvider",
                "Arcanedev\\LogViewer\\Providers\\DeferredServicesProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
